generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                       @id @default(autoincrement())
  email              String                    @unique
  isVerified         Boolean                   @default(false)
  username           String?
  phoneNumber        String?                   @unique
  password           String?
  profileImage       String?
  fcmToken           String?
  lastSeen           DateTime?                 @default(now())
  roleId             Int?
  createdAt          DateTime                  @default(now())
  bio                String?
  banReason          String?
  isBanned           Boolean                   @default(false)
  chatWallpaper      String?
  desktopNotifs      Boolean                   @default(true)
  enterToSend        Boolean                   @default(true)
  messageNotifs      Boolean                   @default(true)
  readReceipts       Boolean                   @default(true)
  showLastSeen       Boolean                   @default(true)
  showProfilePhoto   Boolean                   @default(true)
  soundEnabled       Boolean                   @default(true)
  theme              String                    @default("Dark")
  twoStepEnabled     Boolean                   @default(false)
  wallpaperOpacity   Int                       @default(100)
  twoStepSecret      String?
  autoDownloadDocs   Boolean                   @default(true)
  autoDownloadPhotos Boolean                   @default(true)
  autoDownloadVideos Boolean                   @default(false)
  deactivatedAt      DateTime?
  auditLogs          AuditLog[]
  blockedBy          BlockedUser[]             @relation("UserBlocked")
  blockedUsers       BlockedUser[]             @relation("UserBlocking")
  calls              Call[]                    @relation("UserCalls")
  receivedCalls      Call[]                    @relation("UserReceivedCalls")
  contactOf          Contact[]                 @relation("UserContactOf")
  contacts           Contact[]                 @relation("UserContacts")
  conversations      ConversationParticipant[]
  messages           Message[]                 @relation("UserMessages")
  notifications      Notification[]
  pages              Page[]                    @relation("UserPages")
  followedPages      PageFollower[]            @relation("UserFollowedPages")
  postReactions      PostReaction[]            @relation("UserPostReactions")
  postComments       PostComment[]             @relation("UserPostComments")
  scheduledCalls     ScheduledCall[]           @relation("ScheduledCaller")
  scheduledReceived  ScheduledCall[]           @relation("ScheduledReceiver")
  settings           Setting[]
  statuses           Status[]
  statusViews        StatusView[]              @relation("UserStatusViews")
  role               Role?                     @relation(fields: [roleId], references: [id])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id])
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id     Int    @id @default(autoincrement())
  action String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id])
}

model Contact {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  contactId Int
  createdAt DateTime @default(now())
  contact   User     @relation("UserContactOf", fields: [contactId], references: [id])
  owner     User     @relation("UserContacts", fields: [ownerId], references: [id])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  title        String?
  isGroup      Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  pageId       Int?
  page         Page?                     @relation("PageConversations", fields: [pageId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  senderId       Int
  conversationId Int
  mediaUrl       String?
  isDelivered    Boolean      @default(false)
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  timestamp      DateTime     @default(now())
  type           MessageType  @default(TEXT)
  attachments    Attachment[]
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([conversationId])
}

model Attachment {
  id        Int     @id @default(autoincrement())
  url       String
  type      String
  messageId Int
  message   Message @relation(fields: [messageId], references: [id])
}

model Status {
  id        Int          @id @default(autoincrement())
  userId    Int
  content   String
  mediaUrl  String?
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  views     StatusView[]
}

model StatusView {
  id        Int      @id @default(autoincrement())
  statusId  Int
  userId    Int
  viewedAt  DateTime @default(now())

  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user      User     @relation("UserStatusViews", fields: [userId], references: [id])

  @@unique([statusId, userId])
}

model Call {
  id         Int       @id @default(autoincrement())
  callerId   Int
  receiverId Int
  startedAt  DateTime
  endedAt    DateTime?
  type       CallType
  caller     User      @relation("UserCalls", fields: [callerId], references: [id])
  receiver   User      @relation("UserReceivedCalls", fields: [receiverId], references: [id])
}

model ScheduledCall {
  id          Int      @id @default(autoincrement())
  callerId    Int
  receiverId  Int
  scheduledAt DateTime
  type        CallType @default(AUDIO)
  createdAt   DateTime @default(now())
  caller      User     @relation("ScheduledCaller", fields: [callerId], references: [id])
  receiver    User     @relation("ScheduledReceiver", fields: [receiverId], references: [id])
}

model Notification {
  id             Int       @id @default(autoincrement())
  userId         Int
  type           String
  content        String
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  deliveryError  String?
  deliveryStatus String    @default("SENT")
  user           User      @relation(fields: [userId], references: [id])
}

model Setting {
  id     Int    @id @default(autoincrement())
  userId Int
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  createdAt DateTime @default(now())
  category  String?
  ipAddress String?
  targetId  Int?
  user      User?    @relation(fields: [userId], references: [id])
}

model Page {
  id            Int            @id @default(autoincrement())
  ownerId       Int
  name          String         @unique
  handle        String         @unique
  bio           String?
  avatarUrl     String?
  coverPhotoUrl String?
  isVerified    Boolean        @default(false)
  category      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[] @relation("PageConversations")
  owner         User           @relation("UserPages", fields: [ownerId], references: [id])
  followers     PageFollower[]
  posts         PagePost[]
}

model PageFollower {
  pageId        Int
  userId        Int
  notifications Boolean @default(true)
  page          Page    @relation(fields: [pageId], references: [id])
  user          User    @relation("UserFollowedPages", fields: [userId], references: [id])

  @@id([pageId, userId])
}

model PagePost {
  id        Int            @id @default(autoincrement())
  pageId    Int
  content   String
  mediaUrls String[]
  views     Int            @default(0)
  createdAt DateTime       @default(now())
  page      Page           @relation(fields: [pageId], references: [id])
  reactions PostReaction[]
  comments  PostComment[]
}

model PostReaction {
  id     Int      @id @default(autoincrement())
  postId Int
  userId Int
  emoji  String
  post   PagePost @relation(fields: [postId], references: [id])
  user   User     @relation("UserPostReactions", fields: [userId], references: [id])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  post      PagePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserPostComments", fields: [userId], references: [id])
}


enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

enum CallType {
  AUDIO
  VIDEO
}
